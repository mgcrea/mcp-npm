# @mgcrea/* is our own scope, published by this same CI over OIDC — trusting it
# immediately is a different question from trusting a random third-party bump.
# Without this, a fleet package published minutes ago (like @mgcrea/mcp-totp on
# 2026-09-04) fails pnpm's default 24h minimumReleaseAge on a fresh CI runner,
# which has no local ~/.npmrc exclude the way a developer machine does.
min-release-age-exclude=@mgcrea/*
