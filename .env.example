# ── Registry ─────────────────────────────────────────────────────────────────
# Which registry to talk to. Defaults to the public one. Point it at a private
# registry and the token below is looked up for THAT host in ~/.npmrc, so a
# credential is never sent to a registry it was not issued for.
NPM_REGISTRY=https://registry.npmjs.org

# Download counts live on a different host and never want a token. You will
# almost certainly not change this.
NPM_DOWNLOADS_URL=https://api.npmjs.org

# ── Auth ─────────────────────────────────────────────────────────────────────
# The server works with NO configuration at all: it reads the
# `//registry.npmjs.org/:_authToken=` line that `npm login` writes to ~/.npmrc.
# Run `npm whoami` — if that answers, this server is already configured.
#
# Set NPM_TOKEN only to override that, e.g. in Docker or CI. Create one at
# https://www.npmjs.com/settings/~/tokens
#
# ⚠ Which KIND of token matters more than it looks:
#
#   - A granular access token with "Bypass 2FA" enabled is REFUSED by every
#     trusted-publisher write (403), and by most account operations. Reads keep
#     working, so this only surfaces later, on the write.
#   - Several governance READS — npm_list_tokens, npm_list_org_members,
#     npm_list_collaborators, npm_get_package_visibility — accept ONLY a session
#     token from `npm login`. A granular token is refused on those even though
#     it is accepted for the corresponding writes.
#
# `npm_auth_status` reports which kind you have and what it blocks.
NPM_TOKEN=

# ── Two-factor ───────────────────────────────────────────────────────────────
# npm demands a one-time password on every trusted-publisher endpoint — the READ
# included — and a code lasts about five minutes. Unattended trusted-publisher
# configuration is therefore impossible; this decides how a code is obtained.
#
#   web    (default) open npm's confirmation page in a browser and wait
#   static use the code in NPM_OTP (see the note there)
#   none   never obtain one; the trust tools fail with instructions instead.
#          The right setting for a headless run that must not block.
NPM_OTP_MODE=web

# A one-time password. Almost always the wrong place for one: a code set at
# process start has expired long before anything runs. Use the npm_auth_otp tool
# instead, which takes a fresh code at the moment it is needed.
NPM_OTP=

# How long a confirmed code is reused, and for how many calls. Both mirror npm's
# own cooldown window (~5 minutes, ~80 packages), which is what lets one browser
# confirmation cover a whole batch. Nothing is written to disk.
NPM_OTP_TTL_SECONDS=300
NPM_OTP_MAX_USES=80

# Seconds to wait for the browser confirmation before giving up.
NPM_OTP_TIMEOUT_MS=180000

# Set to 0 to print the authorization URL without launching a browser — for a
# remote machine, or a container.
NPM_AUTO_OPEN_BROWSER=1

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to register the WRITE tools: trusted-publisher changes, dist-tags,
# deprecation, package access, org and team membership, tokens, publish and
# unpublish. Off by default — and "off" means those tools are NOT REGISTERED, so
# an agent cannot call them at all rather than being refused.
#
# Even with this on, everything irreversible additionally requires an explicit
# `confirm: true`, and npm_publish and npm_unpublish both offer a dry run.
NPM_ALLOW_WRITES=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Retry budget for 429 and 5xx. npm publishes no rate-limit headers at all, so
# this is exponential backoff honouring Retry-After when it is present.
NPM_MAX_RETRIES=3

# Path to npm's CLI, used by npm_publish to build the tarball with `npm pack`.
# Only needed when npm is not on this process's PATH — which is the normal case
# for a server started by a GUI app, since it inherits a minimal PATH rather
# than your shell's. Point it at `npm-cli.js` (usually
# <node prefix>/lib/node_modules/npm/bin/npm-cli.js) or at an npm executable.
# Left unset, the server looks for npm beside the Node it is running under.
# NPM_BIN=/opt/homebrew/lib/node_modules/npm/bin/npm-cli.js

# Path to a JSON config file. Named NPM_MCP_CONFIG rather than NPM_CONFIG
# because npm reads its own `npm_config_*` namespace out of the environment.
# Defaults to $XDG_CONFIG_HOME/npm-mcp/config.json, else ~/.config/npm-mcp/config.json
NPM_MCP_CONFIG=

# Set to 1 to log debug output to stderr. Never to stdout: that is the MCP
# protocol channel.
NPM_DEBUG=
